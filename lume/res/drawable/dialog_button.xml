<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog buttons: a soft pill; solid white when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle"><solid android:color="#FFFFFFFF" /><corners android:radius="40dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="#FFFFFFFF" /><corners android:radius="40dp" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="#33FFFFFF" /><corners android:radius="40dp" /></shape>
    </item>
</selector>
